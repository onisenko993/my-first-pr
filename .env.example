# Nova Horizon — переменные окружения
# ВАЖНО: Никогда не коммитьте .env файл в репозиторий!

# База данных
POSTGRES_DB=nova_horizon
POSTGRES_USER=nova_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://nova_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/nova_horizon

# Redis
REDIS_URL=redis://redis:6379/0

# API
API_URL=https://novahorizon.ru

# Claude AI (получить на console.anthropic.com)
CLAUDE_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX

# Travelpayouts (получить на app.travelpayouts.com)
# Токен партнёра
TRAVELPAYOUTS_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Marker (ваш партнёрский ID)
TRAVELPAYOUTS_MARKER=540808

# Telegram Bot (получить у @BotFather)
TELEGRAM_BOT_TOKEN=XXXXXXXXXX:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ЮKassa (для приёма платежей)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Sentry (мониторинг ошибок)
SENTRY_DSN=
